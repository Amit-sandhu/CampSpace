# Copy this file to .env and fill it in. .env is git-ignored.
PORT=5000
HOST=127.0.0.1

# Main database (snippets + run history)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campspace

# Restricted user for the editor's MYSQL language (see server/sql/sandbox.sql)
SANDBOX_DB_USER=campspace_sql
SANDBOX_DB_PASSWORD=change_me_sandbox
SANDBOX_DB_NAME=campspace_sandbox

# Code runner limits
RUN_TIMEOUT_MS=10000
MAX_OUTPUT_BYTES=65536
MAX_CODE_BYTES=100000
MAX_CONCURRENT_RUNS=3

# Only these web origins may call the API (comma separated)
CORS_ORIGIN=http://localhost:5173
